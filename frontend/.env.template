# Plantilla de variables de entorno del frontend.
# Copiar a .env (ignorado por git) y ajustar si el backend no está en localhost.
#
# URL base del backend. Si se omite, en desarrollo la app usa el proxy de Vite
# (/api, que reenvía a http://127.0.0.1:8000) y en producción cae a
# http://127.0.0.1:8000. Descomentá y ajustá solo para apuntar a otro backend.
# VITE_API_URL="http://127.0.0.1:8000"
#
# URL publica del frontend que se usa en el enlace y el QR de la vista publica.
# Para probar desde un celular no sirve localhost: usar la IP LAN de la maquina
# (y levantar Vite con `npm run dev -- --host`) o el dominio publico.
# VITE_PUBLIC_URL="http://192.168.1.50:5173"
