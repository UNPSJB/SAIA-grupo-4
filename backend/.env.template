# Plantilla de variables de entorno del backend.
# Copiar a .env (ignorado por git) y completar las claves:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   (correr dos veces)
ENV="DEV"
ROOT_PATH=""
DB_URL="sqlite:///db.sqlite3"
DB_URL_TEST="sqlite://"
LOG_LEVEL="INFO"
ALGORITHM="HS256"
SECRET_KEY="cambiar-por-clave-secreta-1"
REFRESH_SECRET_KEY="cambiar-por-clave-secreta-2"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_URL="auth/token"
REFRESH_TOKEN_COOKIE_NAME="refresh_token"
SECURE_COOKIES=False
